<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Icon / Logo area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_app"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSDAC Analyzer"
                android:textColor="#00D4FF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Logger Card Data Analyzer"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingTop="4dp"/>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#333355" android:layout_marginBottom="20dp"/>

        <!-- Developer info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVELOPER"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Developed by"
                    android:textColor="#888888" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Akshit Chauhan"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#333355" android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Version"
                    android:textColor="#888888" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#00FF88" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#333355" android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Platform"
                    android:textColor="#888888" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Android 5.0+"
                    android:textColor="#FFFFFF" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Supported Devices card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUPPORTED DEVICES"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="• SSDAC Event Logger Card\n• HASSDAC Event Logger Card\n• DKT Access Control Logger"
                android:textColor="#CCCCCC" android:textSize="13sp" android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- Features card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEATURES"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="• USB Serial connection (OTG)\n• Baud rate: 2400 to 115200 + Custom\n• Download data from flash memory\n• Decode ENTRY / EXIT events\n• RFID Card UID extraction\n• Get / Set RTC time\n• Erase flash memory\n• Save decoded data as .txt file"
                android:textColor="#CCCCCC" android:textSize="13sp" android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- Protocol card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERIAL PROTOCOL"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="%D$    →  Download Data\n%T$    →  Get RTC Time\n%C$    →  Erase Flash\n%ddDDMMYYYYhhmmss$\n       →  Set RTC Time"
                android:textColor="#00FF88" android:textSize="12sp" android:lineSpacingMultiplier="1.6"/>
        </LinearLayout>

        <!-- Copyright -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 Akshit Chauhan. All rights reserved."
            android:textColor="#555555"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

        <!-- Back button -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="← Back"
            android:textColor="#000000"
            android:backgroundTint="#00D4FF"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
